// ============================================================================
// 【模板 08】市场：中国香港 / 美国 | 标的：上市公司（股票） | 数据形态：口径说明 + 跨品种时序指标
// 【重要】A股 F9 路径不适用于港股/美股；港美股财务数据走"对接API\财务数据"族
// 【主营构成已拆分独立模板】
//   港股主营构成 → 见模板 11（港股F9_主营构成_汇总：SetReportFilter 远端过滤 + 分布类型码值 1/2 本地分 Block）
//   美股主营构成 → 见模板 12（按产品/按地区两张独立报表，无分布类型列，分类靠换报表）
// 【口径别名】
//   其他权益及储备（港股/美股口径）→ 港美股 F9 资产负债表的"其他权益及储备"行（A股无同名列）
//   销售、一般及管理费用        → 港美股口径单列；A股需 销售费用+管理费用 组合
//   推销（摊销）= Amortization   → 港股/美股报表口径单列；A股拆为无形资产摊销等
//   留存收益 = Retained earnings → A股用指标"留存收益"
// 【港股/美股指标的 typeCodes = 71,72,79】与海外 F9 报表共用，检索会引入海外噪音，
//   应单独一次调用并直接取用结果，不要在同一轮里与其他市场混检。
// 【三大报表（已确认 + 已执行验证）】均为 GSD 长表结构（一行一科目，实测要点见文末）
//   港股（标准财务数据）：资产负债表GSD|179162995304012 · 利润表GSD|196772091948400 · 现金流量表GSD|410958025816791
//   美股（Choice数据APP）：资产负债表GSD|117896961766961 · 利润表GSD|079899852181141 · 现金流量表GSD|065494405427446
//   过滤列：报告期类型编码(001年报/002中报/003一季/004三季/999最新) / 是否最新报告期 / 报告期 / 报表类型编码 等
// 【可替换参数】证券代码（港股如 00700.HK；美股如 AAPL.O）、窗口起止
// 【示例窗口】窗口起止与年份过滤（如 `YEAR(...) >= 2025`、`Head(5)`）为演示值，非默认业务窗口；使用前按本次研报目标期间替换（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- Block #1：跨品种估值（适用于多市场，时序）----------------------------
// 跨品种CSD 指标覆盖多市场，是港股/美股/全球估值的通用通道
TimeSeriesBlock(#1, {EM_DATE}, {EM_CODE});
SetCodes(["00700.HK", "AAPL.O"]);
SetWindow(
    {开始时间} = "2026-08-01",
    {结束时间} = "2026-10-13",
    {周期} = "日"
);
{市盈率PE(TTM)}: {跨品种CSD\证券分析\股票估值\估值财务指标\市盈率PE(TTM)|328773}();
{市销率PS(TTM)}: {跨品种CSD\证券分析\股票估值\估值财务指标\市销率PS(TTM)|328855}();
OutputBlock();

// ---------------------------------------------------------------------------
// 【动态结束时间对照】走势展示类锚点可把 Block #1 的 {结束时间} 固定日期换成不带引号的
//   N()，刷新即自动延伸到最新日期：{结束时间} = N()
// 硬约束：记号不加引号；普通时序用 N()；_s 报告期时序用 MRQ()；EDB 不支持
// 边界：精确复现类底稿（核验对照、多期整表）保持固定日期，不使用动态记号
// ---------------------------------------------------------------------------

// ---------------------------- Block #2：港股资产负债表（GSD 长表，已执行验证）----------------------------
ReportBlock(#2, {Choice报表\报表指标\Choice金融终端\港股F9\财务数据(新)\标准财务数据\资产负债表\港股F9_资产负债表GSD|179162995304012});
SetCodes(["00700.HK"]);
{证券代码}: REPORT_FIELD("证券代码(带后缀)");
{报告期}: REPORT_FIELD("报告期");
{币种}: REPORT_FIELD("币种");
{科目名称}: REPORT_FIELD("科目名称(调整)");
{科目值}: REPORT_FIELD("科目值");
FILTER_ROWS(YEAR({报告期}) >= 2025);
Sort({报告期}, "DESC");
Head(5);
OutputBlock();

// ---------------------------- Block #3：美股利润表（GSD 长表，已执行验证）----------------------------
ReportBlock(#3, {Choice报表\报表指标\Choice数据APP\美股F9\财务数据\标准财务数据\利润表\美股F9_利润表GSD|079899852181141});
SetCodes(["AAPL.O"]);
{证券代码}: REPORT_FIELD("证券代码(带后缀)");
{报告期}: REPORT_FIELD("报告期");
{币种}: REPORT_FIELD("币种");
{科目名称}: REPORT_FIELD("科目名称(调整)");
{科目值}: REPORT_FIELD("科目值");
FILTER_ROWS(YEAR({报告期}) >= 2025);
Sort({报告期}, "DESC");
Head(5);
OutputBlock();

// ---------------------------------------------------------------------------
// 【GSD 长表结构实测要点】
//   1) 一行一个科目：科目名称(调整)/科目值 成对，另有 科目编码/层级/序号 可还原报表层级；
//      分组标题行（如"流动资产:"）科目值为 NULL，属正常
//   2) 同一科目会按 报表类型编码（合并/母公司、调整前后）返回多行，用 {报表类型编码} 本地收窄
//   3) 全量行数大（腾讯资产负债表 7278 行 / 苹果利润表 5964 行）：生产环境建议 SetReportFilter
//      远端过滤（报告期类型编码/是否最新报告期），写法见模板 11 的 IN 函数式
//   4) 币种随报表返回（腾讯=CNY、苹果=USD）；跨市场比较先统一币种，MQL 不做隐式换算
//   5) 美股财季末非自然季末（苹果 2026-06-27），勿按自然季度假设
// 【备选版本】单季度：港股F9_利润表(单季)GSD|920179732361407、港股F9_现金流量表(单季)GSD|985050229621127、
//   美股F9_利润表(单季)GSD|423381700016106；原始数据版（ARD，带会计准则编码过滤）：
//   港股 121617362877150 / 467146082266488 / 491878055453317
// 【其他海外市场】海外股F9_财务_资产负债表|244840892591737、利润表|143429452568943、
//   现金流量表|612389965242593（日/韩/德/台/印/马来/澳通用镜像；单季度版另有独立 ID）
// ---------------------------------------------------------------------------
