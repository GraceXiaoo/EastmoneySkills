// ============================================================================
// 【模板 02】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：报表 ReportBlock
// 【用途】按报告期取利润表科目；含研报口径别名与"毛利/折旧/摊销/汇兑"的处理说明
// 【主用报表】
//   Choice报表\报表指标\服务端\妙想服务\API查数\基本面\F10_财务分析_利润表_通用|444127832548491
//     - 支持 SetCodes；过滤列：报告期；字段自带"同比比例"列
//   （备选，字段最全 222 项，含销售百分比/同比三套口径）
//   Choice报表\报表指标\服务端\妙想服务\企金工作台\利润表\F9_财务分析_通用类利润表综合|670726101463093
//     银行类利润表|129042385013950
// 【口径别名】
//   毛利润        → 无单列（A股一般企业口径）= 营业收入 − 营业成本（同口径，见模板 06）；
//                    不得用 营业总收入 − 营业总成本（含期间费用与税金）；金融/主营/分部口径须按对应报表另行定义
//                    盘口报表另有"毛利润"字段
//   销售、一般及管理费用 → 销售费用 + 管理费用（+ 研发费用，视口径）
//   净利息支出     → 利息支出 − 利息收入（一般企业用"财务费用"；银行类有独立"利息净收入"）
//   营业外收支     → 营业外收入 − 营业外支出
//   推销（摊销）    → 不在利润表，属现金流量表补充资料（无形资产摊销/长期待摊费用摊销）
//   折旧          → 不在利润表，属现金流量表补充资料（固定资产折旧）
//   股息          → 非利润表科目，见模板 05（每股股利/年度累计分红总额/股息率）
//   转入留存收益    → 无（属所有者权益变动表口径，F9 三大报表不提供）
//   NOPLAT        → 无原生，需自建（见模板 06）
// 【同义写法】营业总收入 = 总收入；归属于母公司股东的净利润 = 归母净利润；扣除非经常性损益后的净利润 = 扣非净利润
// 【可替换参数】证券代码、年份与报告期类型过滤值
// 【示例窗口】下方 `FILTER_ROWS(YEAR(...) >= 2025)` 与 `Head(1)` 为单期演示：年份非默认业务窗口；研报要求多 ACTUAL 期时不得沿用 `Head(1)`，须按目标期数取数（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================
ReportBlock(#1, {Choice报表\报表指标\服务端\妙想服务\API查数\基本面\F10_财务分析_利润表_通用|444127832548491});
SetCodes(["600519.SH"]);
{报告期}: REPORT_FIELD("报告期");
{报告期标签}: REPORT_FIELD("报告期标签");
{报告期类型}: REPORT_FIELD("报告期类型");

// —— 收入与成本 ——
{营业总收入}: REPORT_FIELD("营业总收入");
{营业收入}: REPORT_FIELD("营业收入");
{其他业务收入}: REPORT_FIELD("其他业务收入");
{营业总成本}: REPORT_FIELD("营业总成本");
{营业成本}: REPORT_FIELD("营业成本");
{其他业务成本}: REPORT_FIELD("其他业务成本");
{营业税金及附加}: REPORT_FIELD("营业税金及附加");

// —— 费用（"销售、一般及管理费用"由此组合）——
{销售费用}: REPORT_FIELD("销售费用");
{管理费用}: REPORT_FIELD("管理费用");
{研发费用}: REPORT_FIELD("研发费用");
{其中:研发费用}: REPORT_FIELD("其中:研发费用");
{财务费用}: REPORT_FIELD("财务费用");
{其中:利息费用}: REPORT_FIELD("其中:利息费用");
{利息支出}: REPORT_FIELD("利息支出");
{利息收入}: REPORT_FIELD("利息收入");

// —— 损益 ——
{其他收益}: REPORT_FIELD("其他收益");
{投资收益}: REPORT_FIELD("加:投资收益");
{其中:对联营企业和合营企业的投资收益}: REPORT_FIELD("其中:对联营企业和合营企业的投资收益");
{公允价值变动收益}: REPORT_FIELD("加:公允价值变动收益");
{信用减值损失}: REPORT_FIELD("信用减值损失");
{资产减值损失}: REPORT_FIELD("资产减值损失");
{资产处置收益}: REPORT_FIELD("资产处置收益");
{汇兑收益}: REPORT_FIELD("汇兑收益");
{营业利润}: REPORT_FIELD("营业利润");
{营业外收入}: REPORT_FIELD("加:营业外收入");
{营业外支出}: REPORT_FIELD("减:营业外支出");
{利润总额}: REPORT_FIELD("利润总额");
{所得税费用}: REPORT_FIELD("减:所得税费用");
{净利润}: REPORT_FIELD("净利润");
{持续经营净利润}: REPORT_FIELD("持续经营净利润");
{终止经营净利润}: REPORT_FIELD("终止经营净利润");
{归属于母公司股东的净利润}: REPORT_FIELD("归属于母公司股东的净利润");
{扣除非经常性损益后的净利润}: REPORT_FIELD("扣除非经常性损益后的净利润");
{少数股东损益}: REPORT_FIELD("少数股东损益");

// —— 综合收益与每股 ——
{其他综合收益}: REPORT_FIELD("其他综合收益");
{归属于母公司所有者的综合收益总额}: REPORT_FIELD("归属于母公司所有者的综合收益总额");
{综合收益总额}: REPORT_FIELD("综合收益总额");
{基本每股收益}: REPORT_FIELD("基本每股收益");
{稀释每股收益}: REPORT_FIELD("稀释每股收益");

// 单期演示：年份下限 2025 非默认业务窗口
// 多 ACTUAL 期场景：删除 Head(1)，按目标期数取数（或 Head(目标期数)），同步登记 source_periods/covered_periods
FILTER_ROWS(YEAR({报告期}) >= 2025);
Sort({报告期}, "DESC");
Head(1);
OutputBlock();
