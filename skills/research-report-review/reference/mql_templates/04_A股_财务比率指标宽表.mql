// ============================================================================
// 【模板 04】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：指标 CrossSectionBlock
// 【用途】一次取回常用财务比率/成长/营运/现金流质量指标（截面）；营运能力整表兜底见文末
// 【指标族】Choice指标\股票\沪深京股票指标\…（截面版）
//   同一指标另有 Choice指标\序列函数\…|…_s 时序版（见模板 07），两者 ID 不同，勿混用
// 【口径别名】
//   留存收益      → 留存收益（=盈余公积+未分配利润）；另有"每股留存收益"
//   总资产收益率ROA → 指标侧无同名项，走报表字段"总资产收益率(加权)"（F10_财务分析_主要财务指标）
//   债务权益比     → 不得自动等同"产权比率"：产权比率=负债合计/所有者权益合计；"债务权益比"须按原文口径确认
//                    （可能为有息债务/权益），口径不明时标"待确认"，不与产权比率同义命中
//   自由现金流     → 企业自由现金流量FCFF(反推法) / 股权自由现金流量FCFE
//   现金比率      → 现金比率(货币资金/流动负债) 100000000013974；非"经营活动现金流/流动负债"
//   净负债率      → (带息债务−货币资金)/所有者权益，≠ 净资产负债率(负债/归母权益) ≠ 产权比率
//   正常化市盈率   → 无原生"正常化净利润"口径；近似取"市盈率PE(TTM,扣非)" 100000000022195（口径不等价，须标"近似/待确认"，不作同义命中）
// 【EBIT/EBITDA 两种口径】反推法与正推法差额源自折旧摊销处理，同一张表不可混用
// 【重要】财务指标默认报告期常为"去年年报"，本模板统一显式传 {报告期}="最新一期(MRQ)"
// 【可替换参数】证券代码列表、报告期选项（今年一季/今年中报/今年三季/最新一期(MRQ)/去年年报…）
// 【示例窗口】`SetGlobalVar({报告期} = "最新一期(MRQ)")` 为截面演示，非默认业务窗口；使用前按本次研报目标报告期替换（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================
CrossSectionBlock(#1, {EM_CODE});
SetCodes(["600519.SH", "000858.SZ"]);
SetGlobalVar({报告期} = "最新一期(MRQ)");

{证券代码}: {Choice指标\股票\沪深京股票指标\基本资料\证券资料\股票代码|100000000000869}();
{证券简称}: {Choice指标\股票\沪深京股票指标\基本资料\证券资料\股票简称|100000000000870}();

// —— 资本结构与偿债 ——
{资产负债率}: {Choice指标\股票\沪深京股票指标\财务分析\资本结构\资产负债率|100000000044473}({报告期} = {报告期});
{产权比率}: {Choice指标\股票\沪深京股票指标\财务分析\偿债能力\产权比率|100000000003031}({报告期} = {报告期});
{净负债率}: {Choice指标\股票\沪深京股票指标\财务分析\偿债能力\净负债率|100000000043799}({报告期} = {报告期});
{净资产负债率}: {Choice指标\股票\沪深京股票指标\财务分析\偿债能力\净资产负债率|100000000043318}({报告期} = {报告期});
{现金比率}: {Choice指标\股票\沪深京股票指标\财务分析\偿债能力\现金比率|100000000013974}({报告期} = {报告期});

// —— 盈利能力与费用率 ——
// 注：以下比率返回小数值（0.49 = 49%），展示时需 ×100
{投入资本回报率ROIC}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\投入资本回报率ROIC|100000000002967}({报告期} = {报告期});
{归母净利润率}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\归属于母公司股东的净利润/营业收入|100000000045939}({报告期} = {报告期});
{扣非后销售净利率}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\扣非后销售净利率|100000000042991}({报告期} = {报告期});
{销售费用率}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\销售费用/营业总收入|100000000002979}({报告期} = {报告期});
{管理费用率}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\管理费用/营业总收入|100000000002980}({报告期} = {报告期});
{财务费用率}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\财务费用/营业总收入|100000000002981}({报告期} = {报告期});

// —— 成长 ——
// 注：同比增长率返回小数值（-0.02 = -2%），展示时需 ×100
{营业利润同比增长率}: {Choice指标\股票\沪深京股票指标\财务分析\成长能力\同比增长率\营业利润同比增长率|100000000004684}({报告期} = {报告期});
{扣非归母净利润同比增长率}: {Choice指标\股票\沪深京股票指标\财务分析\成长能力\同比增长率\归属母公司股东的净利润同比增长率(扣除非经常性损益)|100000000004687}({报告期} = {报告期});
{现金净流量同比增长率}: {Choice指标\股票\沪深京股票指标\财务分析\成长能力\同比增长率\现金净流量同比增长率|100000000004693}({报告期} = {报告期});

// —— 营运能力 ——
// 口径提醒：周转率类指标为"年初至今"累计口径，非单季；应付账款周转率无截面指标 → 走文末报表兜底
{总资产周转率}: {Choice指标\股票\沪深京股票指标\财务分析\营运能力\总资产周转率|100000000003055}({报告期} = {报告期});
{应收账款周转率(含应收票据)}: {Choice指标\股票\沪深京股票指标\财务分析\营运能力\应收账款周转率(含应收票据)|100000000003052}({报告期} = {报告期});

// —— 每股指标 ——
//   口径契约：基本每股收益(EPS)分母=期末股本(加权)；每股收益EPS(最新股本摊薄)分母=最新总股本(含发行后重述)；
//   两者分子同为归母净利润口径，但分母基准日不同、口径不等价，不得互相改名、合并或默认互换
{基本每股收益}: {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(基本)|100000000002934}({报告期} = {报告期});
{每股收益EPS(最新股本摊薄)}: {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(最新股本摊薄)|100000000004763}({报告期} = {报告期});
{每股现金流量净额}: {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股现金流量净额|100000000002947}({报告期} = {报告期});
{每股留存收益}: {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股留存收益|100000000005046}({报告期} = {报告期});

// —— 衍生报表数据 ——
{息税前利润EBIT(反推法)}: {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税前利润EBIT(反推法)|100000000003535}({报告期} = {报告期});
{息税折旧摊销前利润EBITDA(反推法)}: {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539}({报告期} = {报告期});
{留存收益}: {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于资产负债表\留存收益|100000000003570}({报告期} = {报告期});
{企业自由现金流量FCFF}: {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于现金流量表\企业自由现金流量FCFF(反推法)|100000000003594}({报告期} = {报告期});
{现金净流量TTM}: {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于现金流量表TTM\现金净流量(TTM)|100000000005122}();

OutputBlock();

// ---------------------------------------------------------------------------
// 【报表兜底：营运能力整表】应付账款周转率/应付账款周转天数无截面指标路径，
// 整表取数用沪深F9_财务分析_营运能力（已执行验证；加载列=报告期+报告期标识）：
ReportBlock(#2, {Choice报表\报表指标\服务端\妙想服务\量化查数\A股\F9\财务分析\营运能力\沪深F9_财务分析_营运能力|138163911685990});
SetCodes(["600519.SH"]);
{应付账款周转率}: REPORT_FIELD("应付账款周转率");
{应付账款周转天数}: REPORT_FIELD("应付账款周转天数");
{应收账款周转率}: REPORT_FIELD("应收账款周转率");
{存货周转率}: REPORT_FIELD("存货周转率");
{总资产周转率}: REPORT_FIELD("总资产周转率");
Head(1);
OutputBlock();
// 上例字段为已执行验证子集；该报表共 26 个字段，其余字段（流动资产周转率、
// 固定资产周转率、各周转天数等）以本次检索返回为准
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// 【报表兜底：B 类无原生指标项】
//   ROA（总资产收益率）→ 沪深F9_财务分析_盈利能力与收益质量，字段"总资产净利率ROA"/"总资产报酬率ROA"
ReportBlock(#3, {Choice报表\报表指标\服务端\妙想服务\量化查数\A股\F9\财务分析\盈利能力与收益质量\沪深F9_财务分析_盈利能力与收益质量|866541668119598});
SetCodes(["600519.SH"]);
{报告期}: REPORT_FIELD("报告期");
{总资产净利率ROA}: REPORT_FIELD("总资产净利率ROA");
{总资产报酬率ROA}: REPORT_FIELD("总资产报酬率ROA");
Sort({报告期}, "DESC");
Head(1);
OutputBlock();

//   实际税率 → F10_财务分析_主要财务指标，字段"实际税率"（仅一般企业）
ReportBlock(#4, {Choice报表\报表指标\服务端\妙想服务\API查数\基本面\F10_财务分析_主要财务指标|594237169895505});
SetCodes(["600519.SH"]);
{报告期}: REPORT_FIELD("报告期");
{实际税率}: REPORT_FIELD("实际税率");
Sort({报告期}, "DESC");
Head(1);
OutputBlock();
// ---------------------------------------------------------------------------
