// ============================================================================
// 【模板 10】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：报表 ReportBlock
// 【用途】主营构成整表取数：收入按产品/行业/地区拆分（同一报表按分布类型本地拆 Block）
// 【主用报表】
//   Choice报表\报表指标\Choice金融终端\A股F9\财务数据(新准则)\主营构成\沪深F9_财务数据(新准则)_主营构成|567134864235497
//     - reportStandardCodeSupported = true → 用 SetCodes 限定标的
//     - reportFilterColumns 为空 → 禁止写 SetReportFilter，
//       「分布类型」「报告期」只能在取数后用本地 FILTER_ROWS 过滤
// 【关键规则】
//   1) 分布类型在 A股报表里返回中文词（"产品"/"行业"/"地区"/"销售模式"），
//      与港股的码值 "1"/"2" 完全不同；
//   2) 「分布类型」只用于本地过滤 → 用私有列（= ）承接，不作为输出列。
//   3) 报告期类型：「报告期类型」列区分累计/单季等口径，研报要求的报告期类型决定保留哪些行。
//   4) 普通值与同比是两套口径：普通值 = 本期主营业务收入，同比 = 本期主营业务收入同比增长率，
//      两者为不同列，不得混用同一列冒充。
//   5) ⚠ 研报要求历史期时，不得只取最新报告期：模板默认只保留 YEAR({报告日期}) >= 2025 的行，
//      必须按研报列出的每个历史报告期分别取数（多 Block 或逐期执行），登记 source_periods/covered_periods；
//      取不到的期按 omitted_periods 如实登记。
//   6) 命名映射：项目名保留报表来源原文（「实际披露项目名称」= 实际披露名），
//      底稿需同时登记数据库标准名与研报名及映射依据，不得用简称或自造名替代来源原文。
// 【可替换参数】证券代码（如 002594.SZ）、分布类型过滤值、年份下限与报告期类型
// 【示例窗口】`YEAR({报告日期}) >= 2025` 为演示下限，非默认业务窗口；历史期须逐期取数，不得只留最新一期（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- Block #1：按产品 ----------------------------
ReportBlock(#1, {Choice报表\报表指标\Choice金融终端\A股F9\财务数据(新准则)\主营构成\沪深F9_财务数据(新准则)_主营构成|567134864235497});
SetCodes(["002594.SZ"]);
{分布类型} = REPORT_FIELD("分布类型");
{证券代码}: REPORT_FIELD("证券代码（带后缀）");
{报告日期}: REPORT_FIELD("报告日期");
{报告期类型}: REPORT_FIELD("报告期类型");
{项目名称}: REPORT_FIELD("实际披露项目名称");
{主营业务收入}: REPORT_FIELD("本期主营业务收入");
{收入占比}: REPORT_FIELD("占主营业务收入比例");
{毛利率}: REPORT_FIELD("本期毛利率");
{收入同比}: REPORT_FIELD("本期主营业务收入同比增长率");
FILTER_ROWS(({分布类型} == "产品") AND (YEAR({报告日期}) >= 2025));
Sort({报告日期}, "DESC");
OutputBlock();

// ---------------------------- Block #2：按行业 ----------------------------
ReportBlock(#2, {Choice报表\报表指标\Choice金融终端\A股F9\财务数据(新准则)\主营构成\沪深F9_财务数据(新准则)_主营构成|567134864235497});
SetCodes(["002594.SZ"]);
{分布类型} = REPORT_FIELD("分布类型");
{证券代码}: REPORT_FIELD("证券代码（带后缀）");
{报告日期}: REPORT_FIELD("报告日期");
{报告期类型}: REPORT_FIELD("报告期类型");
{项目名称}: REPORT_FIELD("实际披露项目名称");
{主营业务收入}: REPORT_FIELD("本期主营业务收入");
{收入占比}: REPORT_FIELD("占主营业务收入比例");
{毛利率}: REPORT_FIELD("本期毛利率");
{收入同比}: REPORT_FIELD("本期主营业务收入同比增长率");
FILTER_ROWS(({分布类型} == "行业") AND (YEAR({报告日期}) >= 2025));
Sort({报告日期}, "DESC");
OutputBlock();

// ---------------------------- Block #3：按地区 ----------------------------
ReportBlock(#3, {Choice报表\报表指标\Choice金融终端\A股F9\财务数据(新准则)\主营构成\沪深F9_财务数据(新准则)_主营构成|567134864235497});
SetCodes(["002594.SZ"]);
{分布类型} = REPORT_FIELD("分布类型");
{证券代码}: REPORT_FIELD("证券代码（带后缀）");
{报告日期}: REPORT_FIELD("报告日期");
{报告期类型}: REPORT_FIELD("报告期类型");
{项目名称}: REPORT_FIELD("实际披露项目名称");
{主营业务收入}: REPORT_FIELD("本期主营业务收入");
{收入占比}: REPORT_FIELD("占主营业务收入比例");
{毛利率}: REPORT_FIELD("本期毛利率");
{收入同比}: REPORT_FIELD("本期主营业务收入同比增长率");
FILTER_ROWS(({分布类型} == "地区") AND (YEAR({报告日期}) >= 2025));
Sort({报告日期}, "DESC");
OutputBlock();
