// ============================================================================
// 【模板 05】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：指标 CrossSectionBlock
// 【用途】一次取回估值与分红指标（PE/PB/PS/PCF/股息率/DPS/分红送转）
// 【口径别名】
//   市盈率(p/e/PE)        → 候选：市盈率PE(TTM) 100000000004742；财报口径/LYR 见下行；口径未标注时按候选处理，
//                          **不得**把原文"PE"静默等同 TTM（PE(TTM)≠PE(LYR)≠最新摊薄口径）
//   财报口径市盈率(LYR)     → 不可回测估值\市盈率PE 100000000004741，{财务数据匹配规则}="上年年报"
//   PE(扣非)             → 市盈率PE(TTM,扣除非经常性损益) 100000000022195
//   动态市盈率             → 序列函数\股票\沪深京股票\估值指标\动态市盈率 100000000022576（时序版，用N()）
//   市净率(P/B/PB)        → 市净率PB(MRQ)（分母=最新归母净资产/最新总股本，时点=最新交易日；≠ PB(LF) 上年年报口径）
//   市销率(P/S/PS)        → 市销率PS(TTM)
//   股息收益率/股息率       → 股息率(TTM) 100000000045682；另有"股息率(最新)"100000000018593、"股息率(年度)"100000000018239
//   股息支付率            → 年度股利支付率（=年度累计分红总额/归母净利润）
//   DPS-最新股本摊薄/每股股息 → 无原生"最新股本摊薄"口径；用 每股股利(税前/税后)（报表：沪深F9_分红送转明细）
//                         或 年度累计分红总额 / 最新总股本 自算
//                         基准日契约：分母股数取研报指定报告期股本，不得一律套用"最新总股本"；自算时须记录所用股数基准日
//   正常化市盈率           → 无原生"正常化净利润"口径；近似取 市盈率PE(TTM,扣非) 100000000022195（口径不等价，须标"近似/待确认"，不作同义命中）
//   股价/现金流(价格/现金流) → 市现率PCF(TTM,现金净流量) 100000000004748（原生指标，已执行验证）；
//                         如坚持"总市值/经营活动现金流量净额"口径，见模板 06 Block #7
//   EV/EBITDA            → 企业倍数EV2/EBITDA 100000000004762（不含货币资金）/ EV1/EBITDA 100000000031744（含货币资金）
// 【参数名差异】不同估值指标参数名不同：PE(不可回测)用{财务数据匹配规则}，动态市盈率用{TTM基准日}，
//   不可统一套用{调整类型}
// 【可替换参数】证券代码、交易日期
// 【示例窗口】`{年度} = "2025年"` 与 `{交易日期} = "最新"` 为演示值，非默认业务窗口；使用前必须替换为本次研报的目标年度与交易日期（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================
CrossSectionBlock(#1, {EM_CODE});
SetCodes(["600519.SH", "000858.SZ"]);
SetGlobalVar({交易日期} = "最新");

{证券代码}: {Choice指标\股票\沪深京股票指标\基本资料\证券资料\股票代码|100000000000869}();
{证券简称}: {Choice指标\股票\沪深京股票指标\基本资料\证券资料\股票简称|100000000000870}();

// —— 估值 ——
{市盈率PE(TTM)}: {Choice指标\股票\沪深京股票指标\估值指标\市盈率PE(TTM)|100000000004742}({交易日期} = {交易日期});
{市盈率PE(LYR)}: {Choice指标\股票\沪深京股票指标\估值指标\不可回测估值\市盈率PE|100000000004741}({交易日期} = {交易日期}, {财务数据匹配规则} = "上年年报");
{市盈率PE(TTM,扣非)}: {Choice指标\股票\沪深京股票指标\估值指标\市盈率PE(TTM,扣除非经常性损益)|100000000022195}({交易日期} = {交易日期});
{市净率PB(MRQ)}: {Choice指标\股票\沪深京股票指标\估值指标\市净率PB(MRQ)|100000000045028}({交易日期} = {交易日期});
{市销率PS(TTM)}: {Choice指标\股票\沪深京股票指标\估值指标\市销率PS(TTM)|100000000004750}({交易日期} = {交易日期});
{市现率PCF(TTM,现金净流量)}: {Choice指标\股票\沪深京股票指标\估值指标\市现率PCF(TTM,现金净流量)|100000000004748}({交易日期} = {交易日期});
{企业倍数EV2/EBITDA}: {Choice指标\股票\沪深京股票指标\估值指标\企业价值\企业倍数EV2/EBITDA|100000000004762}({交易日期} = {交易日期});
{股息率TTM}: {Choice指标\股票\沪深京股票指标\估值指标\股息率(TTM)|100000000045682}({交易日期} = {交易日期});

// —— 股本 ——
{流通股本}: {Choice指标\股票\沪深京股票指标\股本指标\流通股本|100000000015795}({截止日期} = "最新");

// —— 分红 ——
{年度累计分红总额}: {Choice指标\股票\沪深京股票指标\分红指标\年度累计分红总额|100000000000905}({年度} = "2025年");
{年度股利支付率}: {Choice指标\股票\沪深京股票指标\分红指标\年度股利支付率|100000000021007}({年度} = "2025年");
{分红送转}: {Choice指标\股票\沪深京股票指标\分红指标\分红送转|100000000004236}({报告期} = "去年年报");

// —— 指数权重 ——
{所属指数权重}: {Choice指标\股票\沪深京股票指标\行情指标\日行情\所属指数权重|100000000042868}({交易日期} = {交易日期}, {请输入指数代码} = "000300.SH");

OutputBlock();

// ---------------------------------------------------------------------------
// 【配套报表】分红明细（含每股股利税前/税后、派息日、股权登记日）
// Choice报表\报表指标\Choice金融终端\A股F9\分红派息\分红送转明细\沪深F9_分红送转明细|160070019134576
//   过滤列：发放年度(整型)；返回列含：每股股利(税前)/每股股利(税后)/每股送股/每股转增/分红方案/除权除息日/派息日
// 另一张：Choice报表\报表指标\Choice金融终端\API专题报表函数\A股\F9\分红派息\分红\沪深F9_发行与分配_分红|359019150202814
//   过滤列：报告期；返回列含：报告期期末股息率/股息率(%)/股息率(含预案)/税前红利/税后红利
// ---------------------------------------------------------------------------
// ReportBlock(#2, {Choice报表\报表指标\Choice金融终端\A股F9\分红派息\分红送转明细\沪深F9_分红送转明细|160070019134576});
