// {每股股利税前}: REPORT_FIELD("每股股利(税前)");
// {每股股利税后}: REPORT_FIELD("每股股利(税后)");
// {分红方案}: REPORT_FIELD("分红方案");
// {除权除息日}: REPORT_FIELD("除权除息日");
// {派息日}: REPORT_FIELD("派息日");
