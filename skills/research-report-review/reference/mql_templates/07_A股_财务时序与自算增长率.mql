// ============================================================================
// 【模板 07】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：指标 TimeSeriesBlock
// 【用途】财务指标的序列/趋势取数，以及"用两个报告期自算同比增长率"
// 【关键规则】
//   1) 时序版指标路径 = 截面版路径 + "_s" 后缀，ID 不同，必须用 TimeSeriesBlock
//   2) 时序窗口只写 SetWindow；{开始时间}/{结束时间}/{周期} 三件套必填
//   3) 财务报告期序列（_s）周期只写"季"或"年"，且**不写** {市场类型}
//   4) 普通行情时序才用"日/周/月/年"，按需写 {市场类型}
//   5) TimeSeriesBlock 上不能用 Sort/Head/Tail/Slice；需要每证券一个值时加下游 GroupBlock
//   6) 走势展示类可把 {结束时间} 写为不带引号的动态记号：_s 报告期窗口用 MRQ()（自动停在最新
//      已披露报告期），普通行情时序用 N()；记号禁止加引号，EDB 不支持；精确复现类底稿仍用固定日期
// 【已确认的 _s 时序版路径（示例）】
//   每股收益EPS(基本)|100000000002934_s
//   每股收益EPS(最新股本摊薄)|100000000004763_s
//   投入资本回报率ROIC|100000000002967_s
//   归属于母公司股东的净利润/营业收入|100000000045939_s
//   扣非后销售净利率|100000000042991_s
//   管理费用/营业总收入|100000000002980_s
//   财务费用/营业总收入|100000000002981_s
//   销售费用/营业总收入|100000000002979_s
//   总资产周转率|100000000003055_s
//   营业利润同比增长率|100000000004684_s
//   归属母公司股东的净利润同比增长率(扣非)|100000000004687_s
//   现金比率|100000000013974_s
//   息税前利润EBIT(反推法)|100000000003535_s
//   息税折旧摊销前利润EBITDA(反推法)|100000000003539_s
//   现金净流量同比增长率|100000000004693_s
//   净利润-现金流量表|100000000056220_s
//   总股本|100000000018305（序列函数\股票\沪深京股票\股本指标\总股本）
// 【无 _s 时序版的指标（不可写 TimeSeriesBlock）】净负债率|100000000043799、
//   EBIT(正推法)|100000000022361、EBITDA(正推法)|100000000042668、资产负债率、产权比率
//   → 只能用截面 CrossSectionBlock 多期取数
// 【可替换参数】证券代码、窗口起止、周期
// 【示例窗口】窗口起止（如 `{开始时间} = "2023-12-31"`）为时序演示，非默认业务窗口；使用前必须替换为本次研报的目标窗口（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- 序列：财务报告期趋势 ----------------------------
TimeSeriesBlock(#1, {EM_DATE}, {EM_CODE});
SetCodes(["600519.SH"]);
SetWindow(
    {开始时间} = "2023-12-31",
    {结束时间} = "2026-12-31",
    {周期} = "季"
);
{每股收益EPS(基本)}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(基本)|100000000002934_s}();
{每股收益EPS(最新股本摊薄)}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(最新股本摊薄)|100000000004763_s}();
{投入资本回报率ROIC}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\投入资本回报率ROIC|100000000002967_s}();
{归母净利润率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\归属于母公司股东的净利润/营业收入|100000000045939_s}();
{扣非后销售净利率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\扣非后销售净利率|100000000042991_s}();
{销售费用率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\销售费用/营业总收入|100000000002979_s}();
{管理费用率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\管理费用/营业总收入|100000000002980_s}();
{财务费用率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\盈利能力\财务费用/营业总收入|100000000002981_s}();
{总资产周转率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\营运能力\总资产周转率|100000000003055_s}();
{营业利润同比增长率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\成长能力\同比增长率\营业利润同比增长率|100000000004684_s}();
{扣非归母净利润同比增长率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\成长能力\同比增长率\归属母公司股东的净利润同比增长率(扣除非经常性损益)|100000000004687_s}();
{现金比率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\偿债能力\现金比率|100000000013974_s}();
{EBIT(反推法)}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税前利润EBIT(反推法)|100000000003535_s}();
{EBITDA(反推法)}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539_s}();
{现金净流量同比增长率}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\成长能力\同比增长率\现金净流量同比增长率|100000000004693_s}();
OutputBlock();

// ---------------------------- 截面：两期相减自算增长率 ----------------------------
// 用途：Choice 无该指标的现成"增长率"时，用同一指标拉两期自行计算
// 说明：{报告期} 的取值只能用指标元数据声明的 options（如"最新一期(MRQ)""去年中报"），
//       不能自造日期字符串
CrossSectionBlock(#2, {EM_CODE});
SetCodes(["600519.SH"]);
{证券简称}: {Choice指标\股票\沪深京股票指标\基本资料\证券资料\股票简称|100000000000870}();
{每股收益_本期} = {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(基本)|100000000002934}({报告期} = "最新一期(MRQ)");
{每股收益_上年同期} = {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(基本)|100000000002934}({报告期} = "去年中报");
{每股收益增长率} = ({每股收益_本期} - {每股收益_上年同期}) / {每股收益_上年同期} * 100;
{每股收益增长率}: {每股收益增长率};
OutputBlock();

// ---------------------------- 动态结束时间（仅走势展示类）----------------------------
// 用途：趋势展示类底稿希望刷新后自动延伸到最新已披露报告期
// 硬约束：记号不带引号；MRQ() 仅限 _s 报告期窗口；普通时序用 N()；EDB 均不支持
// 边界：精确复现类底稿（财务多期整表、核验对照）不使用动态记号，保持固定日期
TimeSeriesBlock(#3, {EM_DATE}, {EM_CODE});
SetCodes(["600519.SH"]);
SetWindow(
    {开始时间} = "2023-12-31",
    {结束时间} = MRQ(),
    {周期} = "季"
);
{每股收益EPS}: {Choice指标\序列函数\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(基本)|100000000002934_s}();
OutputBlock();

// ---------------------------------------------------------------------------
// 【EBIT增长率 说明】Choice 无 EBIT 的序列指标，两种替代：
//   a) 直接用「营业利润同比增长率」（见模板 04），口径接近；
//   b) 用利润表两期自算：EBIT ≈ 利润总额 + 利息支出 → 按上面 #2 的两期相减模式实现。
// 【EBITDA 序列】直接用时序版（无需 EBITDAPS × 总股本换算）：
//   Choice指标\序列函数\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539_s
//   Choice指标\序列函数\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(正推法)|100000000042668_s
//   口径提醒：反推法折旧摊销取自附注，仅半年报/年报有值，Q1/Q3 为 NULL；季度连续序列用正推法（或截面 TTM 版 |100000000043096）。
// ---------------------------------------------------------------------------
