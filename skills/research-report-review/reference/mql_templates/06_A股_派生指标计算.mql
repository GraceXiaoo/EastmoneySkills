// ============================================================================
// 【模板 06】市场：沪深京A股 | 标的：上市公司（股票） | 数据形态：报表 + 本地表达式 / MergeBlock
// 【用途】把"Choice 无原生口径"的指标**在 MQL 内算出来**（MQL 支持算术、括号、比较）
// 【本文件覆盖的派生指标】
//   1) 其他权益及储备 = 资本公积 + 其他综合收益 + 其他权益工具 + 专项储备
//   2) 其他长期投资   = 其他非流动金融资产 + 债权投资 + 其他债权投资 + 持有至到期投资
//   3) 期末净负债     = 短期借款 + 一年内到期的非流动负债 + 长期借款 + 应付债券 + 租赁负债 − 货币资金
//   4) 销售、一般及管理费用 = 销售费用 + 管理费用
//   5) 净利息支出     = 利息支出 − 利息收入
//   6) 营业外收支净额  = 营业外收入 − 营业外支出
//   7) 毛利润         = 营业收入 − 营业成本（同口径；≠ 营业总收入 − 营业总成本，后者含期间费用与税金）
//   8) NOPLAT        ≈ (利润总额 + 利息支出) × (1 − 所得税费用 / 利润总额)
//   9) 归母净利润率 / 扣非后净利率 = 对应利润 / 营业总收入 × 100
//  10) 剔除投资活动后的现金流 = 经营活动净额 + 筹资活动净额
//  11) 资本支出/收入  = 资本支出 / 营业总收入（跨两张报表 → MergeBlock）
//  12) EV/EBITDA     = 企业倍数EV2/EBITDA（Choice 原生指标，截面/时序均有，无需自算 → Block #5）
//  13) 变动类科目     = 期末 − 上年末（同一截面指标两期取差 → Block #6）：
//      应付账款/预收款项/长期股权投资/应付债券/长期借款/资本公积
//      （"普通股增加"无指标路径 → 用报表字段「实收资本(或股本)」两期取差代理，见模板 01）
//  14) 股价/现金流   = 市现率PCF(TTM,现金净流量)（Choice 原生指标 → Block #5）
//  15) EV/EBIT       = (总市值 + 期末净负债) / (利润总额 + 利息支出)
//      （组成项全有截面指标，一个 Block 内自算，无需 MergeBlock → Block #7）
//  16) C 类 7 项派生（研报比率表缺口，全部在一个 CrossSectionBlock 内算通 → Block #8）：
//      EBIT 增长率 / EBITDA 增长率 / EPS(最新股本摊薄)增长率 = (本期 − 去年同期) / ABS(去年同期)
//      EBITDA 利润率 = EBITDA(反推法) ÷ 营业总收入
//      资本支出/收入 = 购建固定资产等支付的现金 ÷ 营业总收入
//      EV/EBIT      = 企业价值EV1(含货币资金) ÷ EBIT(反推法)
//      正常化市盈率   = 市盈率PE(TTM,扣除非经常性损益)（Choice 无"正常化净利润"口径，此为最接近替代）
// 【除零保护】MQL 的 / 或 MOD 除数为 0 或 NULL 时返回 NULL，不会报错
// 【可替换参数】证券代码、年份与报告期类型过滤值
// 【示例窗口】各 Block 的年份过滤与 `Head(N)` 为演示值，非默认业务窗口；多 ACTUAL 期场景不得沿用 `Head(1)`，须按目标期数取数（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- Block #1：利润表派生 ----------------------------
ReportBlock(#1, {Choice报表\报表指标\服务端\妙想服务\API查数\基本面\F10_财务分析_利润表_通用|444127832548491});
SetCodes(["600519.SH"]);
{证券代码}: REPORT_FIELD("证券代码");
{报告期}: REPORT_FIELD("报告期");
{营业总收入}: REPORT_FIELD("营业总收入");
{营业总成本}: REPORT_FIELD("营业总成本");
{营业收入}: REPORT_FIELD("营业收入");
{营业成本}: REPORT_FIELD("营业成本");
{销售费用}: REPORT_FIELD("销售费用");
{管理费用}: REPORT_FIELD("管理费用");
{利息支出}: REPORT_FIELD("利息支出");
{利息收入}: REPORT_FIELD("利息收入");
{营业外收入}: REPORT_FIELD("加:营业外收入");
{营业外支出}: REPORT_FIELD("减:营业外支出");
{利润总额}: REPORT_FIELD("利润总额");
{所得税费用}: REPORT_FIELD("减:所得税费用");
{归属于母公司股东的净利润}: REPORT_FIELD("归属于母公司股东的净利润");
{扣除非经常性损益后的净利润}: REPORT_FIELD("扣除非经常性损益后的净利润");
// 派生列（同口径取数；任一操作数 NULL → 整式 NULL，不补 0）
// 毛利润：必须用同口径 营业收入 − 营业成本；营业总成本含期间费用与税金，不可作毛利减项
{毛利润} = {营业收入} - {营业成本};
{毛利润}: {毛利润};
{销售、一般及管理费用} = {销售费用} + {管理费用};
{销售、一般及管理费用}: {销售、一般及管理费用};
{净利息支出} = {利息支出} - {利息收入};
{净利息支出}: {净利息支出};
{营业外收支净额} = {营业外收入} - {营业外支出};
{营业外收支净额}: {营业外收支净额};
{NOPLAT近似} = ({利润总额} + {利息支出}) * (1 - {所得税费用} / {利润总额});
{NOPLAT近似}: {NOPLAT近似};
{归母净利润率} = {归属于母公司股东的净利润} / {营业总收入} * 100;
{归母净利润率}: {归母净利润率};
{扣非后净利率} = {扣除非经常性损益后的净利润} / {营业总收入} * 100;
{扣非后净利率}: {扣非后净利率};
FILTER_ROWS(YEAR({报告期}) >= 2025);
Sort({报告期}, "DESC");
Head(1);
OutputBlock();

// ---------------------------- Block #2：资产负债表派生 ----------------------------
ReportBlock(#2, {Choice报表\报表指标\服务端\妙想服务\API查数\基本面\F10_财务分析_资产负债表_通用|747950456281025});
SetCodes(["600519.SH"]);
{报告期}: REPORT_FIELD("报告期");
{货币资金}: REPORT_FIELD("货币资金");
{短期借款}: REPORT_FIELD("短期借款");
{一年内到期的非流动负债}: REPORT_FIELD("一年内到期的非流动负债");
{长期借款}: REPORT_FIELD("长期借款");
{应付债券}: REPORT_FIELD("应付债券");
{租赁负债}: REPORT_FIELD("租赁负债");
{资本公积}: REPORT_FIELD("资本公积");
{其他综合收益}: REPORT_FIELD("其他综合收益");
{其他权益工具}: REPORT_FIELD("其他权益工具");
{专项储备}: REPORT_FIELD("专项储备");
{其他非流动金融资产}: REPORT_FIELD("其他非流动金融资产");
{债权投资}: REPORT_FIELD("债权投资");
{其他债权投资}: REPORT_FIELD("其他债权投资");
{持有至到期投资}: REPORT_FIELD("持有至到期投资");
// 派生列
{其他权益及储备} = {资本公积} + {其他综合收益} + {其他权益工具} + {专项储备};
{其他权益及储备}: {其他权益及储备};
{其他长期投资} = {其他非流动金融资产} + {债权投资} + {其他债权投资} + {持有至到期投资};
{其他长期投资}: {其他长期投资};
{期末净负债} = {短期借款} + {一年内到期的非流动负债} + {长期借款} + {应付债券} + {租赁负债} - {货币资金};
{期末净负债}: {期末净负债};
FILTER_ROWS(YEAR({报告期}) >= 2025);
Sort({报告期}, "DESC");
Head(1);
OutputBlock();

// ---------------------------- Block #3：现金流量表派生 ----------------------------
ReportBlock(#3, {Choice报表\报表指标\服务端\妙想服务\量化查数\A股\F9\财务数据(新准则)\现金流量表(单季度)\F9_财务分析_通用类现金流量表(单季度)|653898154115034});
SetCodes(["600519.SH"]);
{证券代码}: REPORT_FIELD("证券代码(带后缀)");
{报告日期}: REPORT_FIELD("报告日期");
{报表类型代码}: REPORT_FIELD("报表类型代码");
{经营活动产生的现金流量净额}: REPORT_FIELD("经营活动产生的现金流量净额");
{投资活动产生的现金流量净额}: REPORT_FIELD("投资活动产生的现金流量净额");
{筹资活动产生的现金流量净额}: REPORT_FIELD("筹资活动产生的现金流量净额");
{购建固定资产、无形资产和其他长期资产支付的现金}: REPORT_FIELD("购建固定资产、无形资产和其他长期资产支付的现金");
// 派生列
{剔除投资活动后的现金流} = {经营活动产生的现金流量净额} + {筹资活动产生的现金流量净额};
{剔除投资活动后的现金流}: {剔除投资活动后的现金流};
// 注意：这里用 `:` 直接定义输出列，不要再写一行 `{资本支出}: {资本支出};`，否则报"输出名称冲突"
{资本支出}: {购建固定资产、无形资产和其他长期资产支付的现金};
FILTER_ROWS((YEAR({报告日期}) >= 2025) AND ({报表类型代码} == "1"));
Sort({报告日期}, "DESC");
Head(1);
OutputBlock();

// ---------------------------- Block #4：跨报表派生（MergeBlock）----------------------------
// 资本支出/收入：分子在现金流量表(#3)，分母在利润表(#1) → 用业务键"证券代码"补列
// 说明：若需多期严格对齐，把 MergeOn 改成 证券代码 + 报告期 的联合键，并保证右侧键唯一
MergeBlock(#4, #3, #1);
MergeOn(#3.{证券代码} == #1.{证券代码});
{证券代码}: #3.{证券代码};
{报告期}: #3.{报告日期};
{资本支出}: #3.{资本支出};
{营业总收入}: #1.{营业总收入};
{资本支出/收入} = {资本支出} / {营业总收入} * 100;
{资本支出/收入}: {资本支出/收入};
OutputBlock();

// ---------------------------- Block #5：估值类原生指标（EV/EBITDA、市现率PCF，无需自算）----------------------------
// 截面版：估值指标\企业价值\企业倍数EV2/EBITDA；估值指标\市现率PCF(TTM,现金净流量)
// 口径提醒：市现率PCF 分母为现金净流量(TTM)，与"总市值/经营活动现金流净额"口径略有差异
CrossSectionBlock(#5, {EM_CODE});
SetCodes(["600519.SH"]);
{企业倍数EV2/EBITDA}: {Choice指标\股票\沪深京股票指标\估值指标\企业价值\企业倍数EV2/EBITDA|100000000004762}();
{市现率PCF(TTM,现金净流量)}: {Choice指标\股票\沪深京股票指标\估值指标\市现率PCF(TTM,现金净流量)|100000000004748}();
OutputBlock();
// 时序版（普通时序，非 _s 报告期序列）：TimeSeriesBlock + SetWindow，须写 {市场类型}，带 {计算周期} 参数
//   Choice指标\序列函数\股票\沪深京股票\估值指标\企业倍数(EV2/EBITDA)|100000000018238

// ---------------------------- Block #6：变动类科目（期末 − 上年末）----------------------------
// 写法：同一截面指标按两个报告期各取一次，本地取差；结果 >0 为增加、<0 为减少
// 已验证科目（均在 财务报表(全周期)\一般企业\资产负债表 下，均有 _s 时序版）：
//   流动负债\应付账款|100000000055966      流动负债\预收款项|100000000055967
//   非流动资产\长期股权投资|100000000055928 非流动负债\应付债券|100000000056003
//   非流动负债\长期借款|100000000056002    所有者权益\资本公积|100000000056025
// 注意：预收款项科目公司不披露时整列返回 NULL，属正常现象（新准则下多转入合同负债）
CrossSectionBlock(#6, {EM_CODE});
SetCodes(["600519.SH"]);
{应付账款_期末} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\流动负债\应付账款|100000000055966}({报告期} = "最新一期(MRQ)");
{应付账款_上年末} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\流动负债\应付账款|100000000055966}({报告期} = "去年年报");
{应付账款增加} = {应付账款_期末} - {应付账款_上年末};
{应付账款增加}: {应付账款增加};
{长期借款_期末} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\非流动负债\长期借款|100000000056002}({报告期} = "最新一期(MRQ)");
{长期借款_上年末} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\非流动负债\长期借款|100000000056002}({报告期} = "去年年报");
{长期借款增加} = {长期借款_期末} - {长期借款_上年末};
{长期借款增加}: {长期借款增加};
OutputBlock();

// ---------------------------- Block #7：EV/EBIT（组成项全为截面指标，一个 Block 自算）----------------------------
// EV/EBIT = (总市值 + 期末净负债) / (利润总额 + 利息支出)
// 期末净负债 = 短期借款 + 一年内到期的非流动负债 + 长期借款 + 应付债券 + 租赁负债 − 货币资金
CrossSectionBlock(#7, {EM_CODE});
SetCodes(["600519.SH"]);
// 总市值为行情类指标，默认最新交易日；需历史时点时按本次元数据传 {交易日期}
{总市值} = {Choice指标\股票\沪深京股票指标\估值指标\不可回测估值\总市值|100000000004751}();
{货币资金} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\流动资产\货币资金|100000000055884}({报告期} = "最新一期(MRQ)");
{短期借款} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\流动负债\短期借款|100000000055960}({报告期} = "最新一期(MRQ)");
{一年内到期的非流动负债} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\流动负债\一年内到期的非流动负债|100000000055983}({报告期} = "最新一期(MRQ)");
{长期借款} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\非流动负债\长期借款|100000000056002}({报告期} = "最新一期(MRQ)");
{应付债券} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\非流动负债\应付债券|100000000056003}({报告期} = "最新一期(MRQ)");
{租赁负债} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\资产负债表\非流动负债\租赁负债|100000000056020}({报告期} = "最新一期(MRQ)");
{利润总额} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\利润表\利润总额|100000000056088}({报告期} = "最新一期(MRQ)");
{利息支出} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\利润表\利息支出|100000000056061}({报告期} = "最新一期(MRQ)");
{期末净负债} = {短期借款} + {一年内到期的非流动负债} + {长期借款} + {应付债券} + {租赁负债} - {货币资金};
{EV/EBIT} = ({总市值} + {期末净负债}) / ({利润总额} + {利息支出});
{EV/EBIT}: {EV/EBIT};
OutputBlock();
// 备注：总市值另有 时序版（序列函数\股票\沪深京股票\估值指标\总市值|100000000018226）、
//      证监会算法版（截面 |100000000004752 / 时序 |100000000018225）、跨品种版（|326809）
// 【实测注意】组成科目公司无披露时返回 NULL（非 0），且 NULL 在算术中传播：任一项 NULL → 整式 NULL
//   （本块以茅台实测：短期借款/长期借款/应付债券无数据 → EV/EBIT 为 NULL；
//     换有完整披露的报告期或标的可解；底稿侧如需"NULL 按 0 计"须另行说明口径）

// ---------------------------- Block #8：C 类 7 项派生（研报比率表缺口，一个 Block 内算通）----------------------------
// 关键：CrossSectionBlock 支持同一指标按两个 {报告期} 各取一次，本地逐元素运算；
//       估值类指标用 {交易日期}="最新"，财务类用 {报告期}="最新一期(MRQ)"/"去年中报"
CrossSectionBlock(#8, {EM_CODE});
SetCodes(["600519.SH"]);
// —— 本期（最新一期 MRQ）——
{EBIT本期} = {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税前利润EBIT(反推法)|100000000003535}({报告期} = "最新一期(MRQ)");
{EBITDA本期} = {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539}({报告期} = "最新一期(MRQ)");
{EPS本期} = {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(最新股本摊薄)|100000000004763}({报告期} = "最新一期(MRQ)");
{营收本期} = {Choice指标\股票\沪深京股票指标\财务报表(全周期)\一般企业\利润表\营业总收入|100000000056052}({报告期} = "最新一期(MRQ)");
{资本支出本期} = {Choice指标\股票\三板股指标分类\财务报表(标准)\一般企业\现金流量表\投资活动产生的现金流量\购建固定资产、无形资产和其他长期资产支付的现金|100000000000254}({报告期} = "最新一期(MRQ)");
// —— 去年同期（与本期对齐的报告期）——
{EBIT去年同期} = {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税前利润EBIT(反推法)|100000000003535}({报告期} = "去年中报");
{EBITDA去年同期} = {Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据\基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539}({报告期} = "去年中报");
{EPS去年同期} = {Choice指标\股票\沪深京股票指标\财务分析\每股指标\每股收益EPS(最新股本摊薄)|100000000004763}({报告期} = "去年中报");
// —— 估值类（交易日期）——
{EV1本期} = {Choice指标\股票\沪深京股票指标\估值指标\企业价值\企业价值EV1(含货币资金)|100000000004760}({交易日期} = "最新");
{正常化市盈率_近似} = {Choice指标\股票\沪深京股票指标\估值指标\市盈率PE(TTM,扣除非经常性损益)|100000000022195}({交易日期} = "最新");
// —— 派生输出 ——
{EBIT增长率}: ({EBIT本期} - {EBIT去年同期}) / ABS({EBIT去年同期});
{EBITDA增长率}: ({EBITDA本期} - {EBITDA去年同期}) / ABS({EBITDA去年同期});
{EPS最新股本摊薄增长率}: ({EPS本期} - {EPS去年同期}) / ABS({EPS去年同期});
{EBITDA利润率}: {EBITDA本期} / {营收本期};
{资本支出收入比}: {资本支出本期} / {营收本期};
{EV1_EBIT倍数}: {EV1本期} / {EBIT本期};
{正常化市盈率}: {正常化市盈率_近似};
OutputBlock();
// 口径提醒：
//   1. 增长率分母用 ABS()，避免去年同期为负时符号反转；返回小数（-0.05 = -5%）
//   2. EBITDA(反推法) 仅半年报/年报有值，Q1/Q3 的"去年同期"可能为 NULL → 增长率为 NULL
//   3. 正常化市盈率直接取 PE(TTM,扣非)，非真正"正常化净利润"口径，引用须注明
//   4. EV1 含货币资金，EV2 不含；EV/EBIT 用 EV1 与研报常见口径一致

// ---------------------------------------------------------------------------
// 【EBITDA 取数口径】三种原生路径（Choice指标\股票\沪深京股票指标\财务分析\衍生报表数据）：
//   基于利润表\息税折旧摊销前利润EBITDA(反推法)|100000000003539  （截面；时序版 |100000000003539_s）
//   基于利润表\息税折旧摊销前利润EBITDA(正推法)|100000000042668  （截面；无 _s 时序版）
//   基于利润表TTM\EBITDA(TTM,正推法)|100000000043096            （截面）
//   口径提醒：反推法的折旧摊销取自报表附注，仅半年报/年报有值，Q1/Q3 返回 NULL；
//            需要季度连续序列时改用正推法或 TTM 版。
// ---------------------------------------------------------------------------
