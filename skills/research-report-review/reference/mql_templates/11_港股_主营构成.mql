// ============================================================================
// 【模板 11】市场：中国香港 | 标的：上市公司（股票） | 数据形态：报表 ReportBlock
// 【用途】主营构成整表取数：收入按产品/地区拆分（单张汇总表，本地按分布类型码值分 Block）
// 【主用报表】
//   Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\港股F9_主营构成_汇总|251228110707503
//     - 有加载列 → 用 SetReportFilter 远端过滤
//     - 「报告期类型编码」「数据类型」在元数据里标注为必传
// 【关键规则】
//   1) ⚠ IN 必须写函数式 IN({列}, ["值"])，写成中缀 `{列} IN ["值"]` 会报
//      「SetReportFilter 缺少受支持的比较操作符」（实测踩坑）；
//   2) 港股只有两种分类：分布类型 = 1(产品) / 2(地区)；
//   3) 同一报表要按分类拆开 → 各 Block 用本地 FILTER_ROWS 过滤分布类型；
//   4) 「报告期类型名称」有 正常报告期/单季度 两套行，需剔除单季度，否则行数翻倍。
//   5) 普通值与同比由「数据类型」区分：普通报表与同比是两套口径，须显式筛选，不得混列。
//   6) ⚠ 研报要求历史期时，不得只取最新报告期：模板默认 {是否最新报告期} == "1" 只取最新一期，
//      必须按研报列出的每个历史报告期分别取数（多 Block 或逐期执行），登记 source_periods/covered_periods；
//      取不到的期按 omitted_periods 如实登记。
//   7) 命名映射：分部名保留报表来源原文（「标准产品名称」= 数据库标准名），
//      底稿需同时登记数据库标准名与研报名及映射依据，不得用简称或自造名替代来源原文。
// 【可替换参数】证券代码（如 00700.HK）、分布类型过滤值、报告期类型与数据类型
// 【示例窗口】报告期类型/数据类型过滤为演示值：须剔除「单季度」行并以 `{数据类型}` 区分普通值与同比，非默认业务窗口（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- Block #1：按产品（分布类型=1）----------------------------
ReportBlock(#1, {Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\港股F9_主营构成_汇总|251228110707503});
SetCodes(["00700.HK"]);
SetReportFilter(
    {是否最新报告期} == "1"
    AND IN({数据类型}, ["1"])
);
{分布类型} = REPORT_FIELD("分布类型");
{报告期类型名称} = REPORT_FIELD("报告期类型名称");
{证券代码}: REPORT_FIELD("证券代码(带后缀)");
{标准报告期}: REPORT_FIELD("标准报告期");
{标准产品名称}: REPORT_FIELD("标准产品名称");
{主营业务收入}: REPORT_FIELD("主营业务收入");
{主营业务成本}: REPORT_FIELD("主营业务成本");
{毛利}: REPORT_FIELD("毛利");
{毛利率}: REPORT_FIELD("毛利率");
{收入构成}: REPORT_FIELD("收入构成");
{计量币种}: REPORT_FIELD("计量币种");
FILTER_ROWS(({分布类型} == "1") AND ({报告期类型名称} == "正常报告期"));
OutputBlock();

// ---------------------------- Block #2：按地区（分布类型=2）----------------------------
ReportBlock(#2, {Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\港股F9_主营构成_汇总|251228110707503});
SetCodes(["00700.HK"]);
SetReportFilter(
    {是否最新报告期} == "1"
    AND IN({数据类型}, ["1"])
);
{分布类型} = REPORT_FIELD("分布类型");
{报告期类型名称} = REPORT_FIELD("报告期类型名称");
{证券代码}: REPORT_FIELD("证券代码(带后缀)");
{标准报告期}: REPORT_FIELD("标准报告期");
{标准产品名称}: REPORT_FIELD("标准产品名称");
{主营业务收入}: REPORT_FIELD("主营业务收入");
{主营业务成本}: REPORT_FIELD("主营业务成本");
{毛利}: REPORT_FIELD("毛利");
{毛利率}: REPORT_FIELD("毛利率");
{收入构成}: REPORT_FIELD("收入构成");
{计量币种}: REPORT_FIELD("计量币种");
FILTER_ROWS(({分布类型} == "2") AND ({报告期类型名称} == "正常报告期"));
OutputBlock();
