// ============================================================================
// 【模板 12】市场：美国 | 标的：上市公司（股票） | 数据形态：报表 ReportBlock
// 【用途】主营构成整表取数：按产品、按地区是【两张独立报表】，没有「分布类型」列，
//        分类靠换报表，而不是靠过滤列
// 【主用报表】
//   按产品：Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\美股F9主营构成-按产品|034323404267232
//   按地区：Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\美股F9主营构成-按地区|214705396745950
// 【关键规则】
//   1)「报告期类型」= 1 正常报告期(累计) / 2 单季度；不筛会拿到双份数据；
//   2)「数据类型」= 1 普通报表 / 3 同比，同样要筛；
//   3) 报告期是美股的财季末（如 2026-06-27），不是自然季末。
//   4) ⚠ 研报要求历史期时，不得只取最新报告期：模板默认 {是否最新报告期} == "1" 只取最新一期，
//      必须按研报列出的每个历史报告期分别取数（多 Block 或逐期执行），登记 source_periods/covered_periods；
//      取不到的期按 omitted_periods 如实登记。
//   5) 命名映射：分部名保留报表来源原文（「标准产品名称」= 数据库标准名），
//      底稿需同时登记数据库标准名与研报名及映射依据，不得用简称或自造名替代来源原文。
// 【可替换参数】证券代码（如 AAPL.O）、报告期类型与数据类型
// 【示例窗口】`{报告期类型}`（1 累计 / 2 单季）与 `{数据类型}`（1 普通 / 3 同比）为演示说明，非默认业务窗口；使用前必须显式筛选，否则会拿到双份（规则见 index.md 使用规则 6）
// 【字段快照】本模板字段清单为撰写时验证快照，仅示意脚本组织方式；实际可用字段以本次检索返回为准
// ============================================================================

// ---------------------------- Block #1：按产品 ----------------------------
ReportBlock(#1, {Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\美股F9主营构成-按产品|034323404267232});
SetCodes(["AAPL.O"]);
SetReportFilter(
    {是否最新报告期} == "1"
    AND IN({数据类型}, ["1"])
);
{报告期类型} = REPORT_FIELD("报告期类型");
{证券代码}: REPORT_FIELD("证券代码");
{报告期}: REPORT_FIELD("报告期");
{报告期名称}: REPORT_FIELD("报告期名称");
{标准产品名称}: REPORT_FIELD("标准产品名称");
{主营业务收入}: REPORT_FIELD("主营业务收入");
{主营业务成本}: REPORT_FIELD("主营业务成本");
{毛利}: REPORT_FIELD("毛利");
{毛利率}: REPORT_FIELD("毛利率");
{收入构成}: REPORT_FIELD("收入构成");
{计量币种}: REPORT_FIELD("计量币种");
FILTER_ROWS({报告期类型} == "1");
OutputBlock();

// ---------------------------- Block #2：按地区 ----------------------------
ReportBlock(#2, {Choice报表\报表指标\服务端\妙想服务\对接API\财务数据\主营构成\美股F9主营构成-按地区|214705396745950});
SetCodes(["AAPL.O"]);
SetReportFilter(
    {是否最新报告期} == "1"
    AND IN({数据类型}, ["1"])
);
{报告期类型} = REPORT_FIELD("报告期类型");
{证券代码}: REPORT_FIELD("证券代码");
{报告期}: REPORT_FIELD("报告期");
{报告期名称}: REPORT_FIELD("报告期名称");
{标准产品名称}: REPORT_FIELD("标准产品名称");
{主营业务收入}: REPORT_FIELD("主营业务收入");
{主营业务成本}: REPORT_FIELD("主营业务成本");
{毛利}: REPORT_FIELD("毛利");
{毛利率}: REPORT_FIELD("毛利率");
{收入构成}: REPORT_FIELD("收入构成");
{计量币种}: REPORT_FIELD("计量币种");
FILTER_ROWS({报告期类型} == "1");
OutputBlock();
