// @pattern   一般企业口径现金流量表年度时序（经营/投资/筹资/净增加/补充资料，需要 EM_DATE 轴）
// @block     TimeSeriesBlock + 财务报告期 SetWindow(周期=年)
// @replace   代码 ← searchEntity | 窗口起止 ← timeRecognition | 现金流量表科目指标(_s 后缀)
// @must      财务报告期时序：time_series、_s 结尾、前缀 Choice指标\序列函数\；SetWindow 用"年"且不写{市场类型}；指标调用不再传窗口参数
// @verified  2026-09-30 ok=true（22 指标 44 数据点，2 行）
// @note      金额单位元；路径/日期须本次确认(G2)；注释可原样提交

TimeSeriesBlock(#1, {EM_DATE}, {EM_CODE});             // ✅ _s 报告期序列用 TimeSeriesBlock
// ❌ 用普通时序日/周/月窗口  → _s 序列只用"季"/"年"
SetCodes(["002594.SZ"]);
SetWindow(
    {开始时间} = "2024-01-01",
    {结束时间} = "2025-12-31",
    {周期} = "年"                                       // ✅ 财务报告期序列不写 {市场类型}
);
// ❌ 指标调用里再传 {开始时间}/{周期}  → 窗口由 SetWindow 统一传入

