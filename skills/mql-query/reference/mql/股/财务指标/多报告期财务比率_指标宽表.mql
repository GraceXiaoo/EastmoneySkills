// @pattern   多报告期标准化财务比率宽表（"指标"侧，与报表宽/长表示例互为对照）
// @block     CrossSectionBlock（同一 Block 内多次内联 {报告期}）
// @replace   代码 | 财务比率指标path(财务分析\盈利能力\... ) | 各报告期
// @must      财务比率为 cross_section 指标；内联 {报告期} 形成多期宽表；比率类返回小数，显示百分比乘 100
// @note      路径为回归快照，执行前须经 Search_Context 确认(G2)；注释可原样提交

CrossSectionBlock(#1, {EM_CODE});
SetCodes(["600519.SH"]);
// ✅ 比率类指标（ROE/毛利率等）走 财务分析\ 子路径，cross_section，内联报告期取多期
{ROE2024}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\净资产收益率ROE(摊薄)|100000000002960}({报告期} = "2024-12-31");
{ROE2025}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\净资产收益率ROE(摊薄)|100000000002960}({报告期} = "2025-12-31");
{毛利率2024}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\销售毛利率|100000000002972}({报告期} = "2024-12-31");
{毛利率2025}: {Choice指标\股票\沪深京股票指标\财务分析\盈利能力\销售毛利率|100000000002972}({报告期} = "2025-12-31");
OutputBlock();
