// @pattern   最小语法骨架（占位符模板，⚠️ 含 ... 占位符，替换前不能执行）
// @block     CrossSectionBlock（演示完整语句顺序：声明→证券范围→参数→列→过滤→排序→截取→投影）
// @replace   板块fullPath/代码 | 指标path | 日期 | 过滤条件 —— 全部来自当次 Search_Context
// @must      指标必须带()；名称用 {} 包；语句以 ; 结尾；= 私有列不输出、: 才输出；== 相等/<> 不等；布尔小写；日期 "YYYY-MM-DD"
// @note      含 ... 占位符，提交 Execute_MQL 前必须全部替换为本次确认的真实值；注释可原样提交

CrossSectionBlock(#1, {EM_CODE});                      // ✅ 截面 Block 声明；编号带 # 且唯一递增
GetSectors({板块\...\完整板块路径});                    // ⚠️ ... 是占位符，须替换为当次 searchSector.fullPath；花括号包路径、单反斜杠
SetGlobalVar({交易日期} = "2026-09-11");               // ✅ Block 内复用的无结果轴常量
SetParams({交易日期} = {交易日期});                     // ✅ 多指标共用参数走 SetParams；指标内联绑定优先级更高

{内部变量} = {Choice指标\完整\指标\路径}();             // ✅ = 定义私有列，不输出，仅供本 Block 后续引用
// ❌ 漏写 ()  → 无参数指标也必须带 ()
{展示列名}: {内部变量};                                 // ✅ : 定义输出列，进入结果；下游要用的列必须先 : 输出
// ❌ {展示列名} = {内部变量};  → = 不输出，结果里拿不到该列

FILTER_ROWS({条件});                                   // ✅ 写在全部输出列之后、Sort 之前
// ❌ 用 {列} <> NULL 判空  → 必须用 NOT IS_NULL({列})
Sort({展示列名}, "DESC");                              // ✅ 排序键是列名，不能是 {EM_CODE}/{EM_DATE}
Head(20);                                              // ✅ 过滤排序后截取；一个 Block 最多一条截取
OutputBlock();                                         // ✅ 零参数；写了只返回本 Block，不写返回全部
